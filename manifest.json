{
    "manifest_version": 3,
    "name": "FeedBlocker",
    "version": "1.4.0",
    "description": "Track and limit time on social and video sites.",
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "icon-16.png",
            "32": "icon-32.png",
            "48": "icon-48.png",
            "128": "icon-128.png"
        }
    },
    "icons": {
        "16": "icon-16.png",
        "32": "icon-32.png",
        "48": "icon-48.png",
        "128": "icon-128.png"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "background": {
        "service_worker": "src/background/index.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*",
                "*://youtu.be/*",
                "*://*.instagram.com/*",
                "*://*.twitter.com/*",
                "*://*.x.com/*",
                "*://*.tiktok.com/*",
                "*://*.facebook.com/*",
                "*://*.fb.com/*",
                "*://m.facebook.com/*",
                "*://web.facebook.com/*",
                "*://*.reddit.com/*",
                "*://*.linkedin.com/*",
                "*://*.twitch.tv/*",
                "*://*.pinterest.com/*",
                "*://pin.it/*"
            ],
            "js": [
                "src/content/index.tsx"
            ],
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "storage",
        "alarms",
        "webNavigation",
        "tabs"
    ],
    "host_permissions": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.instagram.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*",
        "*://*.fb.com/*",
        "*://m.facebook.com/*",
        "*://web.facebook.com/*",
        "*://*.reddit.com/*",
        "*://*.linkedin.com/*",
        "*://*.twitch.tv/*",
        "*://*.pinterest.com/*",
        "*://pin.it/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "onboarding.html",
                "blocked.html"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}